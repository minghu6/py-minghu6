#!/usr/bin/env bash

# -u unset, -s set
shopt -u nullglob


if [ -z "$MINGHU6_HOME" ]; then
    echo "Error: \$MINGHU6_HOME environment variable is not set." >&2
    exit 1
fi

UV_RUN="uv run --directory $MINGHU6_HOME python3 -m"

command="$1"
case "$command" in
"" )
  echo "Usage alternative: exec $UV_RUN minghu6.tools.<command> \$@"
  ;;
-v | --version )
  exec $UV_RUN minghu6.tools.introspect version
  ;;
-h | --help )
  echo 'Python Minghu6 Tools'
  echo
  echo 'Usage:'
  echo '  pym6 <command> <arguments>..'
  echo '  pym6 dir'
  echo '  pym6 run ...'
  echo
  echo 'Options:'
  echo '  dir        list tools'
  # shellcheck disable=SC2016
  echo "  run        \`$UV_RUN \$@\` with bash module completion"
  echo '  -h --help  print help messages'
  ;;
run)
    shift 1
    exec $UV_RUN "$@"
    ;;
* )
  shift 1
  exec $UV_RUN minghu6.tools."$command" "$@"
  ;;
esac
