_m6ff()
{
    local IFS=$' \t\n'
    local cur prev
    local tags

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    if [[ $COMP_CWORD -eq 1 ]]; then
        tags="cut pconvert merge"
        COMPREPLY=($(compgen -W "${tags}" "$cur"))
        return 0
    fi

    case ${COMP_WORDS[1]} in
        "cut" )
            _complete_file
            return 0
            ;;
        "merge" )
            tags="video"

            COMPREPLY=($(compgen -W "${tags}" "$cur"))
            ;;
        * )
            if [[ "$cur" = @(-o|--output) ]]; then
                _complete_file
                return 0
            fi
            ;;

    esac
}

complete -F _m6ff m6ff
